APP_NAME=BallotBox
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (docker service: mysql) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vote
DB_USERNAME=vote_user
DB_PASSWORD=vote_secret
DB_ROOT_PASSWORD=root_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# --- Redis (docker service: redis) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Realtime bridge: Laravel publishes to Redis, socket-server relays to browsers ---
# SOCKET_SECRET is generated into .env by `make setup`. Browser connects through nginx /socket.io/.
SOCKET_CHANNEL=vote.events
SOCKET_SECRET=

# --- Mail: log only (email is out of scope) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@ballotbox.test"
MAIL_FROM_NAME="${APP_NAME}"
