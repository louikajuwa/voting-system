APP_NAME=BallotBox
APP_ENV=local
APP_KEY=
# Production: APP_ENV=production and APP_DEBUG=false (debug pages leak secrets).
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Production: use warning or error.
LOG_LEVEL=debug

# --- Database (docker service: mysql) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=vote
DB_USERNAME=vote_user
DB_PASSWORD=vote_secret
DB_ROOT_PASSWORD=root_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Production: SESSION_ENCRYPT=true; SESSION_SECURE_COOKIE=true when served over HTTPS.
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

# --- Redis (docker service: redis) ---
REDIS_CLIENT=phpredis
REDIS_HOST=redis
# Set a strong value (e.g. openssl rand -hex 24) to enable Redis auth; "null"/empty = no password (dev only).
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Realtime bridge: Laravel publishes to Redis, socket-server relays to browsers ---
# SOCKET_SECRET is generated into .env by `make setup`. Browser connects through nginx /socket.io/.
SOCKET_CHANNEL=vote.events
SOCKET_SECRET=

# --- Mail: registration requires email verification; "log" writes the link to storage/logs. Use a real SMTP mailer in production. ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@ballotbox.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- Reverse proxy ---
# Comma-separated IPs/CIDRs allowed to set X-Forwarded-For/Proto. Empty = private Docker ranges
# (172.16.0.0/12, 10.0.0.0/8, 192.168.0.0/16, 127.0.0.1). Never use "*".
TRUSTED_PROXIES=
# Socket handshake token lifetime in seconds.
SOCKET_TOKEN_TTL=3600
